{
  "name": "@openmetal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'test/**/*.integration.test.ts'",
    "test:integration": "vitest run test"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@openmetal/contracts": "workspace:*",
    "@openmetal/billing": "workspace:*",
    "@openmetal/db": "workspace:*",
    "@openmetal/events": "workspace:*",
    "@openmetal/logger": "workspace:*",
    "@supabase/supabase-js": "2.112.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openmetal/eslint-config": "workspace:*",
    "@openmetal/sdk": "workspace:*",
    "@openmetal/testkit": "workspace:*",
    "@openmetal/typescript-config": "workspace:*",
    "@types/node": "24.12.0",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
