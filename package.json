{
  "name": "metal",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.13.1"
  },
  "scripts": {
    "dev": "node scripts/dotenvx-run.mjs turbo run dev --filter=@openmetal/web --filter=@openmetal/api --filter=@openmetal/worker --concurrency=12",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "node scripts/dotenvx-run.mjs turbo run test:integration --concurrency=1 && node scripts/dotenvx-run.mjs pnpm --filter @openmetal/api test:runtime-full-stack",
    "test:rls": "node scripts/dotenvx-run.mjs pnpm --filter @openmetal/testkit test:rls",
    "test:realtime": "node scripts/dotenvx-run.mjs pnpm --filter @openmetal/testkit test:realtime",
    "test:live": "METAL_LIVE_TESTS=1 node scripts/dotenvx-run.mjs pnpm --filter @openmetal/worker test:live",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:start": "node scripts/dotenvx-run.mjs supabase start",
    "supabase:stop": "node scripts/dotenvx-run.mjs supabase stop",
    "supabase:reset": "node scripts/dotenvx-run.mjs supabase db reset --local",
    "db:types": "node scripts/dotenvx-run.mjs supabase gen types --local --lang typescript --schema public --schema metal > packages/db/src/database.types.ts",
    "openapi:generate": "pnpm --filter @openmetal/contracts openapi:generate",
    "docs:generate": "pnpm openapi:generate && pnpm --filter @openmetal/web docs:generate-api",
    "env:local": "node scripts/write-local-env.mjs",
    "env:encrypt": "dotenvx encrypt -f .env",
    "env:armor": "node scripts/armor-env.mjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm format:check && pnpm lint"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.23.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "^2.13.1",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  }
}
