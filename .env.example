# Superagent Metal shared development environment template.
# The committed `.env` is the encrypted source of truth for these keys.
# Set a value with `pnpm exec dotenvx set KEY value -f .env`.
# Machine-specific values belong in gitignored `.env.local` (see `.env.local.example`).
# Do not add secrets from other Superagent repos to this file.

# -----------------------------------------------------------------------------
# Browser-safe defaults (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_METAL_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Google and GitHub OAuth secrets belong to Supabase Auth, not Next.js.
# Do not add them as NEXT_PUBLIC_* vars. `pnpm env:local` copies these into
# supabase/.env for the local Auth service.

# -----------------------------------------------------------------------------
# Shared server defaults (apps/api, apps/worker, tests)
# -----------------------------------------------------------------------------
METAL_API_URL=http://127.0.0.1:4000
METAL_SITE_URL=http://localhost:3100
LOG_LEVEL=info
METAL_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# -----------------------------------------------------------------------------
# API process
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
API_REQUEST_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Local Auth OAuth (copied to supabase/.env by `pnpm env:local`)
# -----------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# -----------------------------------------------------------------------------
# Hosted Auth SMTP (Resend). Local Mailpit does not use this.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_replace-with-openmetal-smtp-key

# -----------------------------------------------------------------------------
# Stripe billing (apps/api, apps/worker)
# Use a restricted key with Checkout, Customers, PaymentIntents, and webhook read.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=rk_test_replace-with-restricted-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-signing-secret

# -----------------------------------------------------------------------------
# Worker identity and lease
# -----------------------------------------------------------------------------
WORKER_ID=local-worker-1
WORKER_LEASE_MS=30000
WORKER_POLL_MS=250
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=8
WORKER_BASE_BACKOFF_MS=200
WORKER_COST_SWEEP_MS=300000
METAL_LIVE_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Managed Blaxel Sandbox capacity (worker only)
# -----------------------------------------------------------------------------
BL_API_KEY=replace-with-blaxel-api-key
BL_WORKSPACE=replace-with-blaxel-workspace
# Optional; Metal discovers this from the workspace when omitted.
BLAXEL_ACCOUNT_ID=
BLAXEL_API_URL=https://api.blaxel.ai/v0
BLAXEL_REGION=
BLAXEL_DEFAULT_IMAGE=blaxel/base-image:latest
BLAXEL_DEFAULT_MEMORY_MB=2048

# -----------------------------------------------------------------------------
# Managed Northflank Sandbox capacity (worker only)
# -----------------------------------------------------------------------------
NORTHFLANK_API_TOKEN=replace-with-northflank-api-token
NORTHFLANK_PROJECT_ID=replace-with-northflank-project-id
NORTHFLANK_TEAM_ID=
NORTHFLANK_API_URL=https://api.northflank.com/v1
NORTHFLANK_DEPLOYMENT_PLAN=nf-compute-200
NORTHFLANK_DEFAULT_IMAGE=ubuntu:22.04
NORTHFLANK_EPHEMERAL_STORAGE_MB=2048

# -----------------------------------------------------------------------------
# Managed Runloop Sandbox capacity (worker only)
# -----------------------------------------------------------------------------
RUNLOOP_API_KEY=replace-with-runloop-api-key
RUNLOOP_API_URL=https://api.runloop.ai
RUNLOOP_RESOURCE_SIZE=SMALL
RUNLOOP_BLUEPRINT_ID=
RUNLOOP_VCPU_HOUR_RATE_USD=
RUNLOOP_MEMORY_GB_HOUR_RATE_USD=
RUNLOOP_DISK_GB_HOUR_RATE_USD=

# -----------------------------------------------------------------------------
# Managed CodeSandbox capacity (worker only)
# -----------------------------------------------------------------------------
CODESANDBOX_API_KEY=replace-with-codesandbox-api-key
CODESANDBOX_API_URL=https://api.codesandbox.io
CODESANDBOX_TEMPLATE_ID=pcz35m
CODESANDBOX_VM_TIER=Nano
CODESANDBOX_WORKSPACE_ID=
CODESANDBOX_CREDIT_RATE_USD=0.01486

# -----------------------------------------------------------------------------
# Managed Cloudflare Sandbox capacity (worker only)
# -----------------------------------------------------------------------------
CLOUDFLARE_SANDBOX_API_URL=https://your-sandbox-bridge.workers.dev
CLOUDFLARE_SANDBOX_API_KEY=replace-with-bridge-api-key
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_ANALYTICS_API_TOKEN=replace-with-analytics-read-token

# -----------------------------------------------------------------------------
# Managed Daytona capacity (worker only)
# -----------------------------------------------------------------------------
DAYTONA_API_KEY=replace-with-daytona-api-key
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_ANALYTICS_API_URL=https://analytics.app.daytona.io
DAYTONA_TARGET=
DAYTONA_PAUSE_SUPPORTED=false

# -----------------------------------------------------------------------------
# Managed E2B capacity (worker only)
# -----------------------------------------------------------------------------
E2B_API_KEY=replace-with-e2b-api-key
E2B_API_URL=https://api.e2b.app
E2B_TEMPLATE_ID=base

# -----------------------------------------------------------------------------
# Managed Freestyle capacity (worker only)
# -----------------------------------------------------------------------------
FREESTYLE_API_KEY=replace-with-freestyle-api-key
FREESTYLE_API_URL=https://api.freestyle.sh
FREESTYLE_SNAPSHOT_ID=freestyle/ubuntu-sm

# -----------------------------------------------------------------------------
# Managed Modal capacity (worker only)
# -----------------------------------------------------------------------------
MODAL_TOKEN_ID=replace-with-modal-token-id
MODAL_TOKEN_SECRET=replace-with-modal-token-secret
MODAL_TOKEN_PROFILE=
MODAL_ENVIRONMENT=
MODAL_APP_NAME=metal-sandboxes

# -----------------------------------------------------------------------------
# Managed Vercel Sandbox capacity (worker only)
# -----------------------------------------------------------------------------
VERCEL_TOKEN=replace-with-vercel-access-token
VERCEL_TEAM_ID=team_xxx
VERCEL_PROJECT_ID=prj_xxx
VERCEL_API_URL=https://api.vercel.com
