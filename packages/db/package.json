{
  "name": "@openmetal/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'test/**/*.integration.test.ts'",
    "test:integration": "vitest run test/db.integration.test.ts"
  },
  "dependencies": {
    "@openmetal/contracts": "workspace:*",
    "@openmetal/events": "workspace:*",
    "@openmetal/logger": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.23.0",
    "@openmetal/eslint-config": "workspace:*",
    "@openmetal/typescript-config": "workspace:*",
    "@types/node": "24.12.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
