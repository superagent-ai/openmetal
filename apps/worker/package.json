{
  "name": "@openmetal/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'test/**/*.integration.test.ts' --exclude 'test/**/*.live.test.ts'",
    "test:integration": "vitest run test --exclude 'test/**/*.live.test.ts'",
    "test:byok-live": "vitest run test/byok.live.test.ts",
    "test:live": "vitest run test/providers.live.test.ts"
  },
  "dependencies": {
    "@openmetal/contracts": "workspace:*",
    "@openmetal/billing": "workspace:*",
    "@openmetal/db": "workspace:*",
    "@openmetal/events": "workspace:*",
    "@openmetal/logger": "workspace:*",
    "@openmetal/provider-blaxel": "workspace:*",
    "@openmetal/provider-cloudflare": "workspace:*",
    "@openmetal/provider-codesandbox": "workspace:*",
    "@openmetal/provider-core": "workspace:*",
    "@openmetal/provider-daytona": "workspace:*",
    "@openmetal/provider-e2b": "workspace:*",
    "@openmetal/provider-modal": "workspace:*",
    "@openmetal/provider-northflank": "workspace:*",
    "@openmetal/provider-runloop": "workspace:*",
    "@openmetal/provider-vercel": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openmetal/eslint-config": "workspace:*",
    "@openmetal/testkit": "workspace:*",
    "@openmetal/typescript-config": "workspace:*",
    "@types/node": "24.12.0",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
