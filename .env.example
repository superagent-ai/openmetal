# Superagent Metal local environment template.
# Copy values from `pnpm supabase:start` then `pnpm env:local`.
# Never commit real .env files, tokens, passwords, or secret keys.

# -----------------------------------------------------------------------------
# Browser-safe (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
NEXT_PUBLIC_METAL_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# -----------------------------------------------------------------------------
# Shared server (apps/api, apps/worker, tests)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# Required by the worker trusted Realtime publisher (Realtime HTTP Broadcast).
SUPABASE_SECRET_KEY=replace-with-local-secret-or-service-role-key
METAL_API_URL=http://127.0.0.1:4000
LOG_LEVEL=info
METAL_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# -----------------------------------------------------------------------------
# API process
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
API_REQUEST_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Worker identity and lease
# -----------------------------------------------------------------------------
WORKER_ID=local-worker-1
WORKER_LEASE_MS=30000
WORKER_POLL_MS=250
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=8
WORKER_BASE_BACKOFF_MS=200

# -----------------------------------------------------------------------------
# Managed Daytona capacity (worker only)
# -----------------------------------------------------------------------------
DAYTONA_API_KEY=replace-with-daytona-api-key
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_ANALYTICS_API_URL=https://analytics.app.daytona.io
DAYTONA_TARGET=
