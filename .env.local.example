# Machine-specific local environment.
# Copy to `.env.local` or run `pnpm supabase:start` then `pnpm env:local`.
# Never commit this file. Shared secrets belong in the encrypted `.env`.

# -----------------------------------------------------------------------------
# Local Supabase (from `pnpm env:local`)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
SUPABASE_SECRET_KEY=replace-with-local-secret-or-service-role-key

# -----------------------------------------------------------------------------
# Optional local overrides
# -----------------------------------------------------------------------------
# VERCEL_OIDC_TOKEN=
# METAL_LIVE_TESTS=0
# METAL_LIVE_PROVIDERS=
# METAL_BYOK_ORGANIZATION_SLUG=
# METAL_BYOK_PROVIDER=
# WORKER_ID=local-worker-1
