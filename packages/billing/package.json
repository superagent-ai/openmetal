  },
  "devDependencies": {
    "@openmetal/eslint-config": "workspace:*",
    "@openmetal/typescript-config": "workspace:*",
    "@types/node": "24.12.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
