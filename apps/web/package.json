    "@openmetal/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.2.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
