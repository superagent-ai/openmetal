# Local Supabase Auth OAuth credentials.
# Shared values live in the repo-root encrypted `.env`.
# `pnpm env:local` copies them here for CLI `env()` substitution in config.toml.
# Never commit supabase/.env.

# Google Cloud OAuth Web client (Authorized redirect URI:
# http://127.0.0.1:55321/auth/v1/callback)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# GitHub OAuth App (Authorization callback URL:
# http://127.0.0.1:55321/auth/v1/callback)
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
