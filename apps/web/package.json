{
  "name": "@openmetal/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3100",
    "build": "next build",
    "docs:generate-api": "node scripts/generate-api-docs.mjs && pnpm exec prettier --write \"content/docs/api-reference/endpoints/**/*.{mdx,json}\"",
    "start": "next start --hostname localhost --port 3100",
    "lint": "eslint .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/react": "1.1.9",
    "@openmetal/events": "workspace:*",
    "@openmetal/sdk": "workspace:*",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fumadocs-core": "^16.15.2",
    "fumadocs-mdx": "^15.3.1",
    "fumadocs-openapi": "^11.3.4",
    "fumadocs-ui": "^16.15.2",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.18.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
