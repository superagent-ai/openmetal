{
  "name": "@openmetal/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'test/**/*.integration.test.ts'",
    "test:rls": "vitest run test/rls.integration.test.ts",
    "test:realtime": "vitest run test/realtime.integration.test.ts"
  },
  "dependencies": {
    "@openmetal/contracts": "workspace:*",
    "@openmetal/db": "workspace:*",
    "@openmetal/events": "workspace:*",
    "@openmetal/provider-core": "workspace:*",
    "@openmetal/sdk": "workspace:*",
    "@supabase/supabase-js": "2.112.3",
    "dotenv": "17.4.2",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openmetal/eslint-config": "workspace:*",
    "@openmetal/typescript-config": "workspace:*",
    "@types/node": "24.12.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
